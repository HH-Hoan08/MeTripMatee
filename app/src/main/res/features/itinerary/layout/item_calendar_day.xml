<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginVertical="2dp">

    <!-- Range background highlight -->
    <View
        android:id="@+id/viewRangeHighlight"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:background="@color/calendar_primary_light"
        android:visibility="gone" />

    <!-- Circle background for selected day -->
    <View
        android:id="@+id/viewCircleHighlight"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_pill_teal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvDayNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/calendar_text_dark"
        android:textSize="14sp" />

</FrameLayout>