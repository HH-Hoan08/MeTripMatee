<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="4dp"
    android:paddingVertical="8dp">

    <!-- Avatar hình tròn chứa chữ cái đầu (VD: H, P) -->
    <TextView
        android:id="@+id/tvAvatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_circle_avatar_green"
        android:gravity="center"
        android:text="H"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Nội dung mô tả (VD: Hoàn đã trả tiền phòng, Phú nợ Hoàn) -->
    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_toEndOf="@id/tvAvatar"
        android:layout_toStartOf="@id/tvAmount"
        android:text="Hoàn đã trả tiền phòng"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Số tiền (VD: +1.200.000 đ hoặc -600.000 đ) -->
    <TextView
        android:id="@+id/tvAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:text="+1.200.000 đ"
        android:textColor="#10B981"
        android:textSize="14sp"
        android:textStyle="bold" />

</RelativeLayout>