<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Weather Banner Card -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_weather_card"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ivWeatherIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:contentDescription="Thời tiết"
                android:src="@drawable/ic_weather" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/ivWeatherIcon"
                android:layout_toStartOf="@id/btnForecast"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đà Lạt • 19°C Trời se lạnh"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Gợi ý: Mang áo khoác nhẹ &amp; ô nhỏ"
                    android:textColor="#CCFBF1"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnForecast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="#20FFFFFF"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="Dự báo 3 ngày"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </RelativeLayout>

        <!-- Date Selector Pills -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Day 1 (Selected) -->
                <LinearLayout
                    android:id="@+id/day1Pill"
                    android:layout_width="90dp"
                    android:layout_height="54dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_date_pill_selected"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NGÀY 1"
                        android:textColor="#CCFBF1"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12 Th11"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Day 2 (Unselected) -->
                <LinearLayout
                    android:id="@+id/day2Pill"
                    android:layout_width="90dp"
                    android:layout_height="54dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_date_pill_unselected"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NGÀY 2"
                        android:textColor="#94A3B8"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="13 Th11"
                        android:textColor="#1E293B"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Day 3 (Unselected) -->
                <LinearLayout
                    android:id="@+id/day3Pill"
                    android:layout_width="90dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_date_pill_unselected"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NGÀY 3"
                        android:textColor="#94A3B8"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14 Th11"
                        android:textColor="#1E293B"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Itinerary Dynamic RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvItinerary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:nestedScrollingEnabled="false"
            tools:itemCount="3"
            tools:listitem="@layout/item_itinerary" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>