<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:background="@color/calendar_bg" android:fillViewport="true" android:layout_height="match_parent" android:layout_width="match_parent" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Top Bar -->
        <ImageButton
            android:background="?attr/selectableItemBackgroundBorderless"
            android:id="@+id/btnBack"
            android:layout_height="40dp"
            android:layout_width="40dp"
            android:src="@android:drawable/ic_menu_revert"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <LinearLayout
            android:gravity="center"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnBack">

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Chọn ngày chuyến đi"
                android:textColor="@color/calendar_text_dark"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Chạm ngày đi &amp; ngày về"
                android:textColor="@color/calendar_primary"
                android:textSize="14sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/btnReset"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="Đặt lại"
            android:textColor="@color/calendar_text_gray"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnBack"/>

        <!-- Gợi ý nhanh (Presets) -->
        <TextView
            android:id="@+id/tvPresetLabel"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_width="wrap_content"
            android:text="GỢI Ý NHANH (PRESETS):"
            android:textColor="@color/calendar_text_gray"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBack"/>

        <GridLayout
            android:columnCount="2"
            android:id="@+id/gridPresets"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:rowCount="2"
            app:layout_constraintTop_toBottomOf="@id/tvPresetLabel">

            <!-- Thẻ Preset 1 (Đang chọn) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="@color/calendar_primary_light"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/calendar_primary"
                app:strokeWidth="1dp">
                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:padding="12dp"
                    android:text="⚡ 3N2Đ (12-15/11)"
                    android:textColor="@color/calendar_primary"
                    android:textStyle="bold"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Thẻ Preset 2 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp">
                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:padding="12dp"
                    android:text="🌅 Cuối tuần (T6-CN)"
                    android:textColor="@color/calendar_text_dark"/>
            </com.google.android.material.card.MaterialCardView>
            <!-- Thêm 2 thẻ Preset nữa tương tự thẻ 2 -->
        </GridLayout>

        <!-- Lịch (Calendar View) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/gridPresets">

            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header Lịch -->
                <RelativeLayout
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:layout_width="match_parent">

                    <ImageButton
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:id="@+id/btnPrevMonth"
                        android:layout_alignParentStart="true"
                        android:layout_height="32dp"
                        android:layout_width="32dp"
                        android:src="@android:drawable/ic_media_previous"/>

                    <LinearLayout
                        android:gravity="center"
                        android:layout_centerInParent="true"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvMonthYear"
                            android:layout_height="wrap_content"
                            android:layout_width="wrap_content"
                            android:text="Tháng 11, 2026"
                            android:textColor="@color/calendar_text_dark"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_width="wrap_content"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:text="Mùa săn mây"
                            android:textColor="@color/calendar_primary"
                            android:textSize="10sp"/>
                    </LinearLayout>

                    <ImageButton
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:id="@+id/btnNextMonth"
                        android:layout_alignParentEnd="true"
                        android:layout_height="32dp"
                        android:layout_width="32dp"
                        android:src="@android:drawable/ic_media_next"/>
                </RelativeLayout>

                <!-- Các ngày trong tuần -->
                <LinearLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:weightSum="7">
                    <TextView
                        android:gravity="center"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:text="T2"/>
                    <TextView
                        android:gravity="center"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:text="T3"/>
                    <TextView
                        android:gravity="center"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:text="T4"/>
                    <TextView
                        android:gravity="center"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:text="T5"/>
                    <TextView
                        android:gravity="center"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:text="T6"/>
                    <TextView
                        android:gravity="center"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:text="T7"
                        android:textColor="@color/calendar_primary"/>
                    <TextView
                        android:gravity="center"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:text="CN"
                        android:textColor="@color/calendar_weekend"/>
                </LinearLayout>

                <!-- Lưới hiển thị ngày -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCalendarDays"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Thẻ Tổng kết phía dưới -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/cvCalendar"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent">
                    <TextView
                        android:id="@+id/tvSelectedRange"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Thời gian đã chọn:\n12 Th11 -"
                        android:textColor="@color/calendar_text_dark" />

                    <TextView
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:text="3 Ngày 2 Đêm"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"/>
                </RelativeLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>